# OBLITERATUS - Git Exclusion Protocol

# Binaries and executables
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Payloads and Signal Assets
payloads/*.bin
!payloads/research_signal.bin

# Go dependencies
# NOTE: go.sum IS tracked (supply-chain integrity pinning); only the module
# cache/vendor dir is excluded.
vendor/
go.work
go.work.sum

# OS metadata
.DS_Store
Thumbs.db

# IDEs and local config
.vscode/
.idea/
*.swp
*.log

# Temporary build artifacts
obj/
*.o
*.a

# Go test coverage profile (produced by the CI coverage gate)
cover.out

# gosec JSON report from a local `gosec -fmt=json -out=gosec.json ./...`
gosec.json

# goreleaser output (local --snapshot builds; the CI release uploads these
# to the GitHub Release instead of the tree)
dist/
